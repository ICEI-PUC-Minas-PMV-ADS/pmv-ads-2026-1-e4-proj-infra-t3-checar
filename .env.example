# Copie para .env na raiz do repositório e preencha os valores reais.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# ── Backend API ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# MongoDB (obrigatório em produção)
MONGO_URI=mongodb://127.0.0.1:27017/checar
# Dados de exemplo locais: npm run seed:dev

# Firebase Admin — autenticação JWT (obrigatório para login)
# Gere os arquivos com: npm run firebase:prepare caminho/service-account.json
# Opção A (recomendado local): apontar para arquivo gerado
FIREBASE_SERVICE_ACCOUNT_PATH=.firebase-env.b64.txt
# Opção B: JSON minificado em uma linha
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Opcional ─────────────────────────────────────────────────
# REDIS_URL=redis://127.0.0.1:6379
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# BASE_URL=http://localhost:3000
# RESEND_API_KEY=
# EMAIL_FROM=notificacoes@checar.app
# GESTOR_EMAIL=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_PHOTOS_CONTAINER_NAME=fotos
# AZURE_STORAGE_CONTAINER_NAME=assinaturas

# RabbitMQ (microserviços / docker-compose)
RABBITMQ_USER=checar
RABBITMQ_PASS=senha_segura_local

# Mobile (Expo) — usado por npm run start:mobile
# Produção (mesmos dados do web): https://checarapp.azurewebsites.net
# Local (backend na máquina): http://SEU_IP_LOCAL:3000
EXPO_PUBLIC_API_URL=https://checarapp.azurewebsites.net
