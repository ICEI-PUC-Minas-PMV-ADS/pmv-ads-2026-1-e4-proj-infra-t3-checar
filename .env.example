# Backend
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/checar
PORT=3000
NODE_ENV=production

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_PHOTOS_CONTAINER_NAME=fotos
AZURE_SIGNATURES_CONTAINER_NAME=assinaturas

# Redis (opcional — fallback síncrono se ausente)
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=checar
RABBITMQ_PASS=troque_esta_senha

# Email (Resend)
RESEND_API_KEY=re_...
GESTOR_EMAIL=gestor@empresa.com

# CORS (separar por vírgula)
ALLOWED_ORIGINS=https://checarapp.azurewebsites.net,http://localhost:5173

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
