import React, { useState } from "react";
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  Alert
} from "react-native";

export default function Cadastro() {
  const [nome, setNome] = useState("");
  const [email, setEmail] = useState("");
  const [senha, setSenha] = useState("");
  const [tipoUsuario, setTipoUsuario] = useState("Motorista");

  const handleCadastro = async () => {
    try {
      const response = await fetch("http://localhost:3000/usuarios", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          nome,
          email,
          senha,
          tipoUsuario,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        Alert.alert("Erro", data.mensagem || "Erro ao cadastrar");
        return;
      }

      Alert.alert("Sucesso", "Usuário cadastrado com sucesso!");

      // limpa o formulário
      setNome("");
      setEmail("");
      setSenha("");
      setTipoUsuario("Motorista");

    } catch (error) {
      console.error(error);
      Alert.alert("Erro", "Erro ao conectar com o servidor");
    }
  };

  return (
    <View style={styles.container}>
      <View style={styles.card}>
        <Text style={styles.title}>Cadastro</Text>

        <TextInput
          placeholder="Nome"
          style={styles.input}
          value={nome}
          onChangeText={setNome}
        />

        <TextInput
          placeholder="Email"
          style={styles.input}
          value={email}
          onChangeText={setEmail}
          keyboardType="email-address"
        />

        <TextInput
          placeholder="Senha"
          style={styles.input}
          value={senha}
          onChangeText={setSenha}
          secureTextEntry
        />

        <View style={styles.radioGroup}>
          <TouchableOpacity onPress={() => setTipoUsuario("Motorista")}>
            <Text style={tipoUsuario === "Motorista" ? styles.selected : styles.option}>
              🚗 Motorista
            </Text>
          </TouchableOpacity>

          <TouchableOpacity onPress={() => setTipoUsuario("Gestor")}>
            <Text style={tipoUsuario === "Gestor" ? styles.selected : styles.option}>
              🧑‍💼 Gestor
            </Text>
          </TouchableOpacity>
        </View>

        <TouchableOpacity style={styles.button} onPress={handleCadastro}>
          <Text style={styles.buttonText}>Cadastre-se</Text>
        </TouchableOpacity>

        <Text style={styles.link}>Esqueci minha senha</Text>
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: "#001F3F",
    justifyContent: "center",
    alignItems: "center",
  },
  card: {
    backgroundColor: "#fff",
    padding: 30,
    borderRadius: 10,
    width: "85%",
    alignItems: "center",
  },
  title: {
    fontSize: 22,
    fontWeight: "bold",
    marginBottom: 10,
  },
  input: {
    width: "100%",
    padding: 10,
    marginVertical: 8,
    borderRadius: 5,
    borderWidth: 1,
    borderColor: "#ccc",
  },
  radioGroup: {
    flexDirection: "row",
    justifyContent: "space-around",
    width: "100%",
    marginVertical: 10,
  },
  option: {
    fontSize: 16,
    color: "#555",
  },
  selected: {
    fontSize: 16,
    color: "#001F3F",
    fontWeight: "bold",
  },
  button: {
    width: "100%",
    padding: 12,
    backgroundColor: "#001F3F",
    borderRadius: 5,
    alignItems: "center",
    marginTop: 10,
  },
  buttonText: {
    color: "#fff",
    fontWeight: "bold",
  },
  link: {
    marginTop: 10,
    color: "#001F3F",
    fontSize: 14,
  },
});